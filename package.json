{
  "name": "ips5-mcp",
  "version": "0.0.1",
  "description": "MCP server stub for Invision Community 5 REST API integration",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ips5-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "extract-endpoints": "node scripts/extract-endpoints.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "invision-community",
    "ips5"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
