# Base URL of your Invision Community 5 site (no trailing slash), e.g. https://community.example.com
IPS5_BASE_URL=

# REST API key from ACP → System → REST & OAuth → API Keys
IPS5_API_KEY=

# --- Hosted HTTP mode (Bunny Magic Containers / remote Cursor) ---
# MCP_TRANSPORT=stdio
# MCP_TRANSPORT=http
# PORT=8080
# MCP_AUTH_TOKEN=
# MCP_ALLOWED_HOSTS=mc-xxx.b-cdn.net

# Auth mode: token (Cursor static bearer), oauth (ChatGPT), or both (default)
# MCP_AUTH_MODE=both

# OAuth for ChatGPT MCP (see docs/oauth-chatgpt.md)
# MCP_OAUTH_ISSUER_URL=https://mcp.example.com
# MCP_RESOURCE_URL=https://mcp.example.com/mcp
# IPS_OAUTH_CLIENT_ID=
# IPS_OAUTH_CLIENT_SECRET=
# IPS_OAUTH_SCOPES=profile
# MCP_ADMIN_GROUP_IDS=
# MCP_ALLOWED_MEMBER_IDS=
# MCP_OAUTH_STORE_PATH=/data/oauth-store.json
